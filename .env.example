# Copy to .env, replace every placeholder, then chmod 600 .env.
# Use URL-safe/alphanumeric generated secrets to avoid Compose interpolation.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-database-password
OJS_ADMIN_EMAIL=admin@example.org
# Public HTTPS origin; replace PUBLIC_IP with the attached static IPv4 address.
OJS_PUBLIC_BASE_URL=https://PUBLIC_IP
OJS_API_CREDENTIALS_HOST_FILE=./.secrets/api-client.env
OJS_DB_API_USER=ojs_api
OJS_DB_API_PASSWORD_FILE=./.secrets/db-api-password

OJS_DB_NAME=pkpbeacon_db
OJS_MYSQL_IMAGE=mysql:8.4.0
OJS_PYTHON_IMAGE=python:3.12.15-slim-bookworm
OJS_API_PORT=8000
OJS_OAI_PAGE_SIZE=50
OJS_API_MAX_PAGE_SIZE=200
OJS_API_CONCURRENCY=8
# Cost-first 4 GiB host: one worker, compressed input/tables, bounded retention.
OJS_BEACON_URL=https://beacon.publicknowledgeproject.org/mysql/pkpbeacon.gz
OJS_BEACON_CREDENTIALS_FILE=.secrets/beacon.ini
OJS_COMPACT_STORAGE=1
OJS_METADATA_WORKERS=1
# Progress heartbeats in seconds: a finite number from 1 through 3600.
OJS_PROGRESS_SECONDS=30
OJS_MYSQL_BUFFER_POOL_SIZE=768M
OJS_BUILDER_MYSQL_MAX_CONNECTIONS=8
OJS_BUILDER_MYSQL_TEMPTABLE_MAX_RAM=64M
OJS_SERVING_MYSQL_BUFFER_POOL_SIZE=512M
OJS_SERVING_MYSQL_MAX_CONNECTIONS=16
OJS_SERVING_MYSQL_TEMPTABLE_MAX_RAM=64M
OJS_SERVING_MYSQL_MEMORY_LIMIT=1024m
OJS_SERVING_MYSQL_MEMORY_RESERVATION=512m
OJS_SERVING_MYSQL_MEMSWAP_LIMIT=1536m
OJS_API_MEMORY_LIMIT=256m
OJS_API_MEMSWAP_LIMIT=384m
# Capacity is measured; no mandatory 1 TB volume. Monitor stops a build before
# it uses the reserve. The first full-data build establishes the actual peak.
OJS_MIN_FREE_GB=20
OJS_DISK_RESERVE_GB=8
OJS_MIN_AVAILABLE_MEMORY_MB=512
OJS_UPDATE_NICE=15
# 30 days per coordinator run; the systemd service allows 31 days overall.
OJS_MAX_RUNTIME_HOURS=720
OJS_MAX_ACTIVE_SOURCE_DROP_FRACTION=0.10
OJS_MAX_ACTIVE_ARTICLE_DROP_FRACTION=0.05
OJS_MAX_ARTICLE_REMOVAL_FRACTION=0.05
OJS_MAX_ARTICLE_MERGE_FRACTION=0.01

# Optional standalone HTML scraper. The compact daily job always uses Beacon.
OJS_SOURCE_INDEX_URL=
# OJS_SOURCE_INDEX_URL=https://example.com/ojs-data/
# OJS_SOURCE_USERNAME=
# OJS_SOURCE_PASSWORD=
# OJS_SOURCE_ALLOW_CROSS_ORIGIN=0
OJS_SOURCE_MAX_EXPANDED_GB=500

# Set these to the UID/GID of the account that runs src/run_pipeline.py.
OJS_HOST_UID=1000
OJS_HOST_GID=1000
