[Unit]
Description=Check PKP Beacon, build compressed catalogue, and replace the serving release
Requires=docker.service
After=network-online.target docker.service
RequiresMountsFor=/srv/ojs_api/data

[Service]
Type=oneshot
User=ojs
Group=ojs
WorkingDirectory=/srv/ojs_api
EnvironmentFile=/srv/ojs_api/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/ojs_api/scripts/automatic_update.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ojs-api-update
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
CPUWeight=25
IOWeight=25
MemoryHigh=1792M
MemoryMax=2048M
MemorySwapMax=1024M
TasksMax=256
OOMScoreAdjust=500
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/ojs_api/data
TimeoutStartSec=31d
TimeoutStopSec=5min
